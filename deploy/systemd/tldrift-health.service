# Missed-run and stale-ingestion check; runs on its own timer so a stalled monitor job is still detected.
[Unit]
Description=Temporal Legal Drift monitoring health check
OnFailure=tldrift-alert@%n.service

[Service]
Type=oneshot
User=tldrift
WorkingDirectory=/srv/temporal-legal-drift
EnvironmentFile=-/etc/tldrift/tldrift.env
ExecStart=/srv/temporal-legal-drift/.venv/bin/tldrift monitor-health --check
ExecStartPost=/srv/temporal-legal-drift/deploy/heartbeat.sh
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/temporal-legal-drift/data
