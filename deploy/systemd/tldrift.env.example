# Copy to /etc/tldrift/tldrift.env (mode 0640, owner root:tldrift). Never commit the real file.
# Command that receives the alert text on stdin, e.g. a mail client or a webhook wrapper you control.
TLDRIFT_ALERT_COMMAND="mail -s tldrift-alert ops@example.org"
# Optional dead-man's-switch URL pinged after each healthy check; an external service alerts when pings stop
# (covers the whole host being down, which no local timer can report).
TLDRIFT_HEARTBEAT_URL=
