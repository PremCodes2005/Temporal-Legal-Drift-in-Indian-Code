{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://temporal-legal-drift.local/schemas/annotation/materiality_llm_assessment.v1.schema.json",
  "title": "Structured LLM materiality assessment; never legal gold",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pair_id", "rubric_version", "label", "evidence", "rationale", "uncertainty", "insufficient_evidence"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pair_id": {"type": "string", "minLength": 1},
    "rubric_version": {"type": "string", "minLength": 1},
    "label": {"enum": ["High", "Medium", "Low", "None", null]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "quote"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "rationale": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "string"},
    "insufficient_evidence": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"insufficient_evidence": {"const": true}}, "required": ["insufficient_evidence"]},
      "then": {"properties": {"label": {"const": null}}},
      "else": {"properties": {"label": {"enum": ["High", "Medium", "Low", "None"]}, "evidence": {"minItems": 1}}}
    }
  ]
}
