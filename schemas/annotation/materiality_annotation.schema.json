{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/temporal-legal-drift/materiality-annotation.schema.json",
  "title": "Independent materiality annotation",
  "type": "object",
  "required": ["annotation_id", "pair_id", "annotator_id", "submitted_at", "label", "dimensions", "rationale", "evidence_spans", "confidence", "guideline_version"],
  "properties": {
    "annotation_id": {"type": "string"},
    "pair_id": {"type": "string"},
    "annotator_id": {"type": "string"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "label": {"enum": ["High", "Medium", "Low", "None"]},
    "dimensions": {"type": "array", "items": {"type": "string"}},
    "rationale": {"type": "string", "minLength": 1},
    "evidence_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "text"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "guideline_version": {"type": "string"},
    "temporal_concerns": {"type": "array", "items": {"type": "string"}},
    "compliance_consequence_note": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
