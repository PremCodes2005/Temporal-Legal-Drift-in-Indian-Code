{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://temporal-legal-drift.local/schemas/annotation/materiality_evaluation_split.v1.schema.json",
  "title": "Pre-registered materiality model evaluation split",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "split_id", "split_method", "group_key", "train_pair_ids", "test_pair_ids"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "split_id": {"type": "string", "minLength": 1},
    "split_method": {"enum": ["act_held_out", "amendment_event_held_out", "provision_lineage_held_out", "source_held_out", "temporal_holdout", "domain_held_out"]},
    "group_key": {"enum": ["act_id", "amendment_event_id", "provision_id", "source_id", "time_bucket", "domain"]},
    "train_pair_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "test_pair_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
