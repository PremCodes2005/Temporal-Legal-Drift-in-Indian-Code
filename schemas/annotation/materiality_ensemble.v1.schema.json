{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://temporal-legal-drift.local/schemas/annotation/materiality_ensemble.v1.schema.json",
  "title": "Optional machine ensemble with mandatory review and no gold status",
  "type": "object",
  "required": ["schema_version", "ensemble_id", "status", "source_silver_sha256", "source_assessments_sha256", "case_count", "ensemble_enabled", "ensemble_method", "review_required_count", "rows", "legal_correctness_claimed", "is_gold"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "ensemble_id": {"const": "materiality-optional-ensemble-v1"},
    "status": {"const": "optional_machine_ensemble_not_gold"},
    "source_silver_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_assessments_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case_count": {"const": 50},
    "ensemble_enabled": {"const": true},
    "review_required_count": {"const": 50},
    "legal_correctness_claimed": {"const": false},
    "is_gold": {"const": false},
    "rows": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["pair_id", "rule_a_prediction", "rule_b_prediction", "rule_tiebreak_prediction", "llm_prediction", "ensemble_votes", "ensemble_label", "ensemble_status", "ensemble_disposition", "gold_status"],
        "properties": {
          "ensemble_label": {"enum": ["High", "Medium", "Low", "None", null]},
          "ensemble_status": {"enum": ["REVIEW_REQUIRED", "INSUFFICIENT_EVIDENCE"]},
          "ensemble_disposition": {"enum": ["PROVISIONAL_MAJORITY", "ABSTAIN_NO_MAJORITY"]},
          "gold_status": {"const": "NOT_GOLD"}
        }
      }
    }
  }
}
