{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/temporal-legal-drift/baseline-run.schema.json",
  "title": "Phase 8 baseline dry-run manifest",
  "type": "object",
  "required": ["schema_version", "experiment_id", "status", "input_fingerprints", "baseline_registry", "feature_rows", "metrics", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_id": {"type": "string"},
    "status": {"const": "features_prepared_evaluation_blocked_no_gold"},
    "input_fingerprints": {"type": "object"},
    "baseline_registry": {"type": "array"},
    "feature_rows": {"type": "array"},
    "metrics": {"type": "null"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
