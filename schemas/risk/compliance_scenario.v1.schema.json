{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComplianceScenario v1 — risk assessment input",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenario_id", "organization_type", "industry", "jurisdiction", "facts", "reference_date", "applicable_provision", "activity", "exposure"],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "organization_type": {"type": ["string", "null"], "minLength": 1},
    "industry": {"type": ["string", "null"], "minLength": 1},
    "jurisdiction": {"type": ["string", "null"], "minLength": 1},
    "facts": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
    "reference_date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "applicable_provision": {"type": ["string", "null"], "minLength": 1},
    "activity": {"type": ["string", "null"], "minLength": 1},
    "exposure": {"type": "object", "additionalProperties": false, "required": ["description", "amount"], "properties": {"description": {"type": ["string", "null"]}, "amount": {"type": ["number", "null"], "minimum": 0}}}
  }
}
